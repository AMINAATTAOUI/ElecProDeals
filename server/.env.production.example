# Copier ce fichier en .env sur Railway (variables d'environnement)
# NE JAMAIS commiter les valeurs réelles

NODE_ENV=production
PORT=3000

# PostgreSQL — fourni par Railway (coller l'URL depuis le dashboard)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT — générer avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE_ME_64_CHARS_MIN
JWT_REFRESH_SECRET=CHANGE_ME_64_CHARS_MIN_DIFFERENT
JWT_ACCESS_EXPIRES_IN_SECONDS=900
JWT_REFRESH_EXPIRES_IN_SECONDS=604800

# CORS — URL de l'admin Next.js en prod + expo tunnel si besoin
CORS_ORIGINS=https://admin.elecprodeals.fr,https://votre-tunnel.exp.direct

# Feature flags
STRIPE_ENABLED=false
SAGE_MOCK_MODE=true
